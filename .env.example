# ── Sanity (blog CMS) ────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# The site builds fine with these blank — the blog just uses the built-in
# seed posts until Sanity is connected. See BLOG-CMS.md.

# From sanity.io/manage → your project → Project ID
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Same project ID again, under the name the Sanity CLI (`npm run studio`,
# `npm run blog:import`) looks for. Keep the two in sync.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional. Only needed if you want unpublished drafts to show in preview
# builds. Create at sanity.io/manage → API → Tokens (Viewer permission).
SANITY_API_READ_TOKEN=
