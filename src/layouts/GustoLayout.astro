---
import "../styles/gusto.css";
import ConceptSwitcher from "../components/ConceptSwitcher.astro";

interface Props {
  title?: string;
  description?: string;
  brunetta?: boolean;
}
const {
  title = "Gusto Verde",
  description = "Celebration of Flavor and Ambiance — Palo Alto restaurant template by Pixsellz.",
  brunetta = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {brunetta && <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Afacad:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,300;1,9..144,400&display=swap"
    />
  </head>
  <body class:list={["gv-page", brunetta && "gv-page--brunetta"]}>
    <slot />
    <ConceptSwitcher design={2} />
    <script>
      const prefersReduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!prefersReduced) {
        document.body.classList.add("motion-ready");
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
      }

      // Hero image rotate
      const slides = document.querySelectorAll<HTMLElement>("[data-hero-slide]");
      if (slides.length > 1 && !prefersReduced) {
        let i = 0;
        slides.forEach((s, idx) => {
          s.style.opacity = idx === 0 ? "1" : "0";
          s.style.transition = "opacity 1s ease";
          s.style.position = idx === 0 ? "relative" : "absolute";
          s.style.inset = "0";
        });
        setInterval(() => {
          slides[i].style.opacity = "0";
          i = (i + 1) % slides.length;
          slides[i].style.opacity = "1";
        }, 4500);
      }

      // Menu tabs (visual only — starters content is the dump default)
      document.querySelectorAll<HTMLButtonElement>("[data-menu-tab]").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("[data-menu-tab]").forEach((b) => b.classList.remove("is-active"));
          btn.classList.add("is-active");
        });
      });
    </script>
  </body>
</html>
