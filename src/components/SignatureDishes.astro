---
import { homepage, menu, nav } from "../data/brunetta";
import { foodAll } from "../data/photos";

const { signature } = homepage;
const signaturePhotos = ["DSC06525", "DSC05579", "DSC09771"].map(name => foodAll.find(photo => photo.name === name)!);
const allItems = menu.flatMap(section => section.items);
const dishes = signature.dishNames
  .map(name => allItems.find(item => item.name === name))
  .filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<section id="signature-plates" class="signature-sequence" aria-labelledby="signature-title">
  <div class="signature-menu">
    <div class="signature-menu__panel">
      <h2 id="signature-title">{signature.panelTitle}</h2>
      <ul>
        {dishes.map(dish => <li>
          <div class="signature-menu__dish"><span>{dish.name}</span><span>{dish.price}</span></div>
          <p>{dish.description}</p>
        </li>)}
      </ul>
      <div class="signature-menu__footer"><a href={nav.menu.href} class="btn-dark">View Full Menu</a></div>
    </div>
  </div>

  <div class="signature-photos" aria-label="Signature plate photography">
    {signaturePhotos.map((photo, index) => <figure class="signature-photo">
      <img class="box-border h-full w-full object-cover align-middle inline-block overflow-clip" src={photo.src} alt={photo.alt} width="1600" height="1066" loading="lazy" decoding="async" />
      {index === 0 && <figcaption class="signature-photo__intro">
        <h3>{signature.sideTitle}</h3>
        <p>{signature.sideBody}</p>
        <a href={signature.cta.href} target="_blank" rel="noopener" class="btn-dark">{signature.cta.label}</a>
      </figcaption>}
    </figure>)}
  </div>
</section>

<style>
  .signature-sequence {
    --signature-height: calc(100svh - var(--brunetta-nav-height));
    display: grid;
    grid-template-columns: 45% 55%;
    align-items: start;
    background: var(--dark);
    scroll-margin-top: var(--brunetta-nav-height);
  }
  /* Native pinning: the left column stays put until the third photo's bottom passes it. */
  .signature-menu {
    position: sticky;
    top: var(--brunetta-nav-height);
    height: var(--signature-height);
    padding: clamp(16px, 2vw, 28px);
  }
  .signature-menu__panel { height: 100%; display: flex; flex-direction: column; background: var(--primary); color: var(--dark); border-radius: 3px; }
  .signature-menu h2 { font-size: clamp(36px, 4vw, 64px); font-weight: 300; text-transform: uppercase; line-height: .9; letter-spacing: -.03em; padding: 18px 18px 14px; }
  .signature-menu ul { display: flex; flex-direction: column; flex: 1; margin: 0; padding: 0; list-style: none; }
  .signature-menu li { flex: 1; border-top: 1px solid #29262270; padding: clamp(6px, 1vh, 12px) 18px; }
  .signature-menu__dish { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-size: clamp(14px, 1.15vw, 18px); font-weight: 600; line-height: 1.2; }
  .signature-menu__dish > :last-child { flex-shrink: 0; }
  .signature-menu li p { margin-top: 4px; font-size: clamp(12px, 1vw, 15px); line-height: 1.3; }
  .signature-menu__footer { padding: 10px 18px 16px; }
  .signature-menu__footer a { display: block; text-align: center; padding: 12px; font-size: 14px; min-height: 44px; }
  .signature-photo { height: var(--signature-height); min-height: 560px; margin: 0; position: relative; overflow: clip; background: var(--biege); }
  .signature-photo img { height: 100%; width: 100%; object-fit: cover; }
  .signature-photo__intro { position: absolute; inset: 0; padding: clamp(24px, 3vw, 48px); color: var(--biege); background: linear-gradient(180deg, #171412ee, #171412a0 42%, transparent 75%); }
  .signature-photo__intro h3 { max-width: 16ch; font-size: clamp(38px, 4vw, 64px); font-weight: 300; text-transform: uppercase; line-height: .95; letter-spacing: -.025em; }
  .signature-photo__intro p { max-width: 44ch; font-size: 16px; line-height: 1.5; margin-top: 20px; }
  .signature-photo__intro a { background: var(--biege); color: var(--dark); margin-top: 22px; font-size: 14px; }
  @media (min-width: 768px) and (max-height: 740px) {
    .signature-menu h2 { font-size: 36px; padding: 14px 16px 12px; }
    .signature-menu li { padding: 6px 16px; }
    .signature-menu li p { font-size: 12px; }
  }
  @media (min-width: 768px) and (max-width: 1000px) {
    .signature-sequence { grid-template-columns: 50% 50%; }
    .signature-menu { padding: 12px; }
    .signature-menu h2 { font-size: 30px; padding: 14px 14px 12px; }
    .signature-menu li { padding: 5px 14px; }
    .signature-menu__dish { font-size: 14px; }
    .signature-menu li p { font-size: 12px; }
    .signature-menu__footer { padding: 8px 14px 12px; }
  }
  @media (max-width: 767px), (max-height: 599px) {
    .signature-sequence { display: block; }
    .signature-menu { position: static; height: auto; padding: 20px; }
    .signature-menu h2 { font-size: 48px; padding: 24px 18px; }
    .signature-menu li { padding: 14px 18px; }
    .signature-menu__dish { font-size: 16px; }
    .signature-menu li p { font-size: 14px; line-height: 1.5; }
    .signature-photo { height: 110vw; min-height: 480px; max-height: 760px; }
    .signature-photo__intro h3 { font-size: 38px; }
    .signature-photo__intro p { font-size: 15px; }
  }
  /* Mobile: keep only the captioned photo (the one carrying the heading + button). */
  @media (max-width: 767px) {
    .signature-photos .signature-photo:not(:first-child) { display: none; }
  }
</style>
