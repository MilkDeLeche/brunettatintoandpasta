---
import PlaceholderImage from "./PlaceholderImage.astro";
import { homepage, contact } from "../data/brunetta";

const { privateEvents } = homepage;
---

<section class="catering overflow-hidden bg-[var(--surface-raised)] py-0">
  <div class="px-[1.75em] pb-[2.75em] pt-[6em]">
    <div class="mx-auto max-w-[70em] text-center" data-reveal>
      <h2 class="text-[5.75em] font-light uppercase leading-[0.85] tracking-[-0.03em] text-[var(--dark)]" data-letters>
        {privateEvents.line1}
      </h2>
      <div class="mt-[0.4em] grid grid-cols-1 items-center gap-3 md:grid-cols-[0.5fr_1.75fr_0.4fr]">
        <p class="caption_heading text-[0.85em] uppercase text-[var(--dark)] md:text-left" data-letters>
          {privateEvents.captionLeft}
        </p>
        <h2 class="text-[5.75em] font-light uppercase leading-[0.85] tracking-[-0.03em] text-[var(--dark)]" data-letters>
          {privateEvents.line2}
        </h2>
        <p class="caption_heading text-[0.85em] uppercase text-[var(--dark)] md:text-right" data-letters>
          {privateEvents.captionRight}
        </p>
      </div>
      <p class="mx-auto mt-[1.25em] max-w-[47ch] text-[1.05em] leading-[1.55] text-[var(--dark)]/80">
        {privateEvents.body}
      </p>
      <p class="mt-[0.75em] text-[0.9em] text-[var(--dark)]/60">{privateEvents.ctaNote}</p>
      <a href={`tel:${contact.phoneE164}`} class="btn-dark mt-[1.25em]">{contact.phone}</a>
    </div>
  </div>

  <div class="flex flex-col gap-[0.38em] px-[0.4em] pb-[2em] md:flex-row">
    {
      privateEvents.cards.map((card, i) => (
        <article class="w-full md:w-1/3" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <div class="h-[35em] overflow-hidden">
            <PlaceholderImage label={card.imageLabel} fill class="h-full w-full" />
          </div>
          <div class="px-[0.75em] pt-[0.85em]">
            <h3 class="font-display text-[1.6em] font-light uppercase tracking-[-0.02em] text-[var(--dark)]">
              {card.title}
            </h3>
            <p class="mt-[0.5em] text-[1em] leading-[1.5] text-[var(--dark)]/75">{card.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
