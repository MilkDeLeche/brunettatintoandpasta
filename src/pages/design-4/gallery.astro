---
import Design4Layout from "../../layouts/Design4Layout.astro";
import { business } from "../../data/brunetta";
import { foodAll } from "../../data/photos";
---

<Design4Layout
  title={`Gallery — ${business.name}`}
  description="Pasta, pizza, seafood, steak and dessert from the kitchen at Brunetta Tinto & Pasta."
  path="/design-4/gallery"
>
  <section class="pc-page-head">
    <div class="pc-wrap">
      <p class="pc-eyebrow">From Our Kitchen</p>
      <h1 class="pc-title">A taste of <em>Brunetta</em></h1>
    </div>
  </section>

  <section class="pc-block pc-wrap">
    <div class="pc-gallery">
      {foodAll.map((photo) => (
        <a href={photo.src} data-lb data-alt={photo.alt} aria-label={`Enlarge: ${photo.alt}`}>
          <img src={photo.thumb} alt={photo.alt} loading="lazy" width="640" height="426" />
        </a>
      ))}
    </div>
  </section>

  <dialog class="pc-lightbox" aria-label="Photo viewer">
    <button type="button" aria-label="Close">×</button>
    <img alt="" />
    <p></p>
  </dialog>
</Design4Layout>

<script>
  const lb = document.querySelector<HTMLDialogElement>(".pc-lightbox")!;
  const img = lb.querySelector("img")!;
  const cap = lb.querySelector("p")!;
  let opener: HTMLElement | null = null;
  document.querySelectorAll<HTMLAnchorElement>("[data-lb]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      opener = a;
      img.src = a.href;
      img.alt = a.dataset.alt ?? "";
      cap.textContent = a.dataset.alt ?? "";
      lb.showModal();
    })
  );
  lb.querySelector("button")!.addEventListener("click", () => lb.close());
  lb.addEventListener("close", () => opener?.focus());
  lb.addEventListener("click", (e) => {
    const r = lb.getBoundingClientRect();
    if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) lb.close();
  });
</script>
