---
// Shared, design-agnostic 404 — deliberately NOT wired to either concept's
// Layout/Header/Footer, since a 404 can be hit from either /design-1 or
// /design-2 and shouldn't look like it belongs to just one of them.
import { business } from "../data/brunetta";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found — {business.name}</title>
    <meta name="description" content="This page could not be found." />
    <meta name="robots" content="noindex" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        background: #101010;
        color: #f2ede4;
        font-family: Arial, sans-serif;
        text-align: center;
        padding: 2rem;
      }
      h1 {
        font-size: 4rem;
        margin: 0;
      }
      p {
        max-width: 26rem;
        opacity: 0.75;
        margin: 0;
      }
      .links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 1rem;
      }
      a {
        color: inherit;
        border: 1px solid rgba(242, 237, 228, 0.35);
        border-radius: 3px;
        padding: 0.65rem 1.25rem;
        text-decoration: none;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      a:hover {
        border-color: #f2ede4;
      }
    </style>
  </head>
  <body>
    <h1>404</h1>
    <p>We couldn't find that page. It may have moved — pick a concept below or head back to the start.</p>
    <div class="links">
      <a href="/">All Concepts</a>
      <a href="/design-1">Design 1</a>
      <a href="/design-2">Design 2</a>
    </div>
  </body>
</html>
