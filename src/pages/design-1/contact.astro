---
// No contact form yet — SETUP-LIST item 2 asks the client for a monitored
// inbox. Shipping a form with nowhere for messages to land would silently
// lose inquiries, so phone + Reserve are the primary paths until that's back.
import Layout from "../../layouts/Layout.astro";
import RevealHeadline from "../../components/RevealHeadline.astro";
import { business, contact, location, hours, nav } from "../../data/brunetta";
---

<Layout
  title={`Contact — ${business.name}`}
  description={`Call ${business.name} at ${contact.phone} or make a reservation online.`}
  path="/design-1/contact"
>
  <section class="bg-cream">
    <div class="mx-auto max-w-3xl px-5 py-20 text-center md:px-8 md:py-28">
      <p data-reveal class="font-script text-2xl text-amber-deep">Get In Touch</p>
      <RevealHeadline text="Contact Us" as="h1" class="mt-3 text-5xl leading-[1.02] md:text-6xl" />

      <div data-reveal class="mt-12 grid gap-8 text-left sm:grid-cols-2">
        <div class="border-t border-ink/15 pt-4">
          <p class="text-xs uppercase tracking-[0.2em] text-ink/50">Phone</p>
          <a href={`tel:${contact.phoneE164}`} class="mt-1 block font-display text-2xl hover:text-amber-deep">
            {contact.phone}
          </a>
          <p class="mt-1 text-xs text-ink/50">{contact.largePartyNote}</p>
        </div>

        <div class="border-t border-ink/15 pt-4">
          <p class="text-xs uppercase tracking-[0.2em] text-ink/50">Address</p>
          <p class="mt-1 font-display text-xl">{location.street}</p>
          <p class="font-display text-xl">{location.city}, {location.state} {location.zip}</p>
        </div>

        <div class="border-t border-ink/15 pt-4 sm:col-span-2">
          <p class="text-xs uppercase tracking-[0.2em] text-ink/50">Hours</p>
          <ul class="mt-2 space-y-1">
            {hours.displayGrouped.map((row) => (
              <li class="flex justify-between text-sm">
                <span class="text-ink/70">{row.label}</span>
                <span>{row.value}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a
        href={nav.primaryCta.href}
        target="_blank"
        rel="noopener"
        class="mt-12 inline-block rounded-sm bg-amber px-8 py-3.5 font-body text-sm font-semibold uppercase tracking-[0.12em] text-black hover:bg-amber-deep"
      >
        Make a Reservation
      </a>
    </div>
  </section>
</Layout>
