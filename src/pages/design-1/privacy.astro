---
// DRAFT — launch-audit (pipeline step 4) requires the client to review this
// before go-live. Discloses exactly the third parties this build actually
// uses (see src/data/brunetta.ts): Google Maps, Reserve with Google, Google
// Fonts / Fontshare, and analytics once one is chosen (SETUP-LIST item 6).
import Layout from "../../layouts/Layout.astro";
import { business, contact } from "../../data/brunetta";
---

<Layout
  title={`Privacy Policy — ${business.name}`}
  description={`How ${business.name} collects and uses information on this website.`}
  path="/privacy"
>
  <section class="bg-cream">
    <div class="mx-auto max-w-2xl px-5 py-20 text-ink/80 md:px-8 md:py-28">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-amber-deep">Draft — pending review</p>
      <h1 class="mt-3 font-display text-4xl text-ink">Privacy Policy</h1>
      <p class="mt-2 text-sm text-ink/50">Last updated: [date] — to be confirmed before launch.</p>

      <div class="mt-8 space-y-6 leading-relaxed">
        <p>
          {business.name} ("we," "us") operates this website. This policy explains what
          information is collected when you visit and how it's used.
        </p>

        <div>
          <h2 class="font-display text-xl text-ink">Information we collect</h2>
          <p class="mt-2">
            We do not require an account to browse this site. If you use the reservation button,
            you'll be taken to Google's "Reserve with Google" service, which handles your booking
            information under Google's own privacy policy. If a contact form is added, the
            information you submit is sent to our team's inbox and is not sold or shared.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl text-ink">Third-party services</h2>
          <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>Google Maps — for the location/directions embed.</li>
            <li>Google Reserve — for table reservations.</li>
            <li>Google Fonts / Fontshare — deliver the fonts used on this site; your browser makes a request to their servers.</li>
            <li>Analytics — [tool to be confirmed] measures aggregate site traffic.</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-xl text-ink">This site was built with AI assistance</h2>
          <p class="mt-2">
            Portions of this website's design and content were produced with the help of AI
            tools. Any illustrative imagery is labeled as such; menu, hours, and business details
            reflect information provided by {business.name}.
          </p>
        </div>

        <div>
          <h2 class="font-display text-xl text-ink">Contact</h2>
          <p class="mt-2">
            Questions about this policy? Call us at{" "}
            <a href={`tel:${contact.phoneE164}`} class="text-amber-deep hover:text-amber">{contact.phone}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
