---
import Layout from "../../../layouts/Layout.astro";
import RevealHeadline from "../../../components/RevealHeadline.astro";
import { business } from "../../../data/brunetta";
import { getPosts, getPost } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPost(slug as string);
if (!post) return Astro.redirect("/design-1/blog");
---

<Layout title={`${post.title} — ${business.name}`} description={post.excerpt} path={`/design-1/blog/${post.slug}`}>
  <article class="bg-cream">
    <div class="mx-auto max-w-2xl px-5 py-20 md:px-8 md:py-28">
      <a href="/design-1/blog" class="text-xs font-semibold uppercase tracking-[0.14em] text-amber-deep hover:text-amber">&larr; Blog</a>

      {post.dateLabel && (
        <p class="mt-6 text-xs uppercase tracking-[0.14em] text-ink/50">
          {post.dateLabel}{post.author ? ` · ${post.author}` : ""}
        </p>
      )}
      <RevealHeadline text={post.title} as="h1" class="mt-2 text-4xl leading-[1.05] md:text-5xl" />

      {post.cover && (
        <img
          src={post.cover.url + "?w=1400&auto=format"}
          alt={post.cover.alt}
          class="mt-8 w-full rounded-sm object-cover"
        />
      )}

      {
        post.bodyHtml ? (
          <div
            data-reveal
            class="prose-block mt-8 space-y-5 text-lg leading-relaxed text-ink/85"
            set:html={post.bodyHtml}
          />
        ) : (
          <div data-reveal class="mt-8 rounded-sm border border-ink/15 bg-cream-soft p-6 text-ink/70">
            <p>{post.excerpt}</p>
            <p class="mt-3 text-sm text-ink/50">Full post coming soon.</p>
          </div>
        )
      }

      {post.tags.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <li class="rounded-full border border-ink/20 px-3 py-1 text-xs uppercase tracking-[0.1em] text-ink/60">
              {tag}
            </li>
          ))}
        </ul>
      )}
    </div>
  </article>
</Layout>
