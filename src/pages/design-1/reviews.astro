---
import Layout from "../../layouts/Layout.astro";
import RevealHeadline from "../../components/RevealHeadline.astro";
import { business, reviews } from "../../data/brunetta";
---

<Layout
  title={`Post a Review — ${business.name}`}
  description="We'd love to hear your thoughts — leave us a review on Google or Facebook."
  path="/design-1/reviews"
>
  <section class="bg-black px-5 py-24 text-center text-cream md:px-8 md:py-32">
    <div class="mx-auto max-w-2xl">
      <p data-reveal class="font-script text-2xl text-amber">Tell Us How We Did</p>
      <RevealHeadline text="We'd love to hear your thoughts." as="h1" class="mt-3 text-4xl leading-[1.05] md:text-5xl" />

      <div data-reveal class="mt-12 flex flex-wrap justify-center gap-4">
        <a
          href={reviews.postAReviewLinks.google}
          target="_blank"
          rel="noopener"
          class="rounded-sm bg-amber px-8 py-3.5 font-body text-sm font-semibold uppercase tracking-[0.12em] text-black hover:bg-amber-deep"
        >
          Review on Google
        </a>
        <a
          href={reviews.postAReviewLinks.facebook}
          target="_blank"
          rel="noopener"
          class="rounded-sm border border-cream/40 px-8 py-3.5 font-body text-sm font-semibold uppercase tracking-[0.12em] hover:border-amber hover:text-amber"
        >
          Review on Facebook
        </a>
      </div>
    </div>
  </section>
</Layout>
