---
import Layout from "../../layouts/Layout.astro";
import RevealHeadline from "../../components/RevealHeadline.astro";
import { business, nav } from "../../data/brunetta";
import { foodAll } from "../../data/photos";
---
<Layout title={`Gallery — ${business.name}`} description="Explore pasta, pizza, seafood, steak and desserts from the kitchen at Brunetta Tinto & Pasta." path="/design-1/gallery">
  <section class="bg-black px-5 py-28 text-cream md:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-script text-2xl text-amber">From Our Kitchen</p>
      <RevealHeadline text="A Taste of Brunetta" as="h1" class="mt-5 text-5xl leading-[1.02] md:text-6xl" />
    </div>
  </section>
  <section class="bg-cream gallery-section">
    <div class="brunetta-gallery">
      {foodAll.map(photo => <a href={photo.src} data-gallery-photo data-alt={photo.alt} aria-label={`Enlarge: ${photo.alt}`}><img src={photo.thumb} alt={photo.alt} loading="lazy" width="640" height="426" /></a>)}
    </div>
    <a href={nav.reserve.href} target="_blank" rel="noopener" class="btn-dark">{nav.reserve.label}</a>
  </section>
  <dialog class="gallery-lightbox" aria-label="Photo gallery">
    <button type="button" aria-label="Close photo">×</button>
    <img alt="" />
    <p></p>
  </dialog>
</Layout>
<style>
  .gallery-section { padding: 40px clamp(20px, 5vw, 80px) 80px; text-align: center; }
  .brunetta-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-bottom: 40px; }
  .brunetta-gallery a { overflow: hidden; }
  .brunetta-gallery img { width: 100%; height: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform 300ms ease-out; }
  .brunetta-gallery a:hover img { transform: scale(1.025); }
  .gallery-lightbox { padding: 16px; border: 0; background: #292622; color: #efe7d8; max-width: 94vw; max-height: 94dvh; }
  .gallery-lightbox:not([open]) { display: none; }
  .gallery-lightbox::backdrop { background: #171513e8; }
  .gallery-lightbox img { max-width: 85vw; max-height: 75dvh; object-fit: contain; }
  .gallery-lightbox p { padding: 16px 0 0; line-height: 1.4; }
  .gallery-lightbox button { display: block; margin-left: auto; width: 44px; height: 44px; font-size: 28px; cursor: pointer; }
  @media(max-width: 700px) { .brunetta-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media(prefers-reduced-motion: reduce) { .brunetta-gallery img { transition: none; } }
</style>
<script>
  const gallery = document.querySelector<HTMLDialogElement>(".gallery-lightbox")!;
  let trigger: HTMLAnchorElement | null = null;
  let previousOverflow = "";
  document.querySelectorAll<HTMLAnchorElement>("[data-gallery-photo]").forEach(link => link.addEventListener("click", event => {
    event.preventDefault(); trigger = link;
    const photo = gallery.querySelector("img")!; photo.src = link.href; photo.alt = link.dataset.alt ?? "";
    gallery.querySelector("p")!.textContent = photo.alt;
    previousOverflow = document.body.style.overflow; document.body.style.overflow = "hidden";
    gallery.showModal();
  }));
  gallery.querySelector("button")!.addEventListener("click", () => gallery.close());
  gallery.addEventListener("close", () => { document.body.style.overflow = previousOverflow; trigger?.focus(); });
  gallery.addEventListener("click", event => {
    if (event.target !== gallery) return;
    const box = gallery.getBoundingClientRect();
    if (event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom) gallery.close();
  });
</script>
